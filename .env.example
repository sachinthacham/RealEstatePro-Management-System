# Optional overrides for `docker compose up`. Copy this file to `.env` in
# the repo root and fill in real values as needed — docker-compose reads
# `.env` automatically. Everything here has a working default for local
# use except JWT_SECRET, which you should still change if this ever runs
# anywhere other than your own machine.

JWT_SECRET=replace-with-a-random-string-at-least-32-characters-long

# Host port for the API (default 5000). Change it if 5000 is taken on your
# machine, then rebuild: `docker compose up --build`.
API_PORT=5000

# Email (SMTP) — leave blank to run without email sending (registration,
# password reset emails will simply fail; everything else still works).
SMTP_HOST=
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
FROM_EMAIL=no-reply@example.com
FROM_NAME=RealEstate

# Stripe — leave blank to run without the membership checkout flow.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
